# Copy to `.env` and fill in real values. NEVER commit a real `.env`.

DJANGO_ENV=development
DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Frontend origins (exact scheme+host+port)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-time code required to create the very first administrator
ADMIN_SIGNUP_CODE=change-me-bootstrap-code

# MySQL
DB_NAME=financial_dashboard
DB_USER=finapp
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_financial_dashboard

# JWT lifetimes
JWT_ACCESS_MINUTES=8
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_NAME=fd_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Alpha Vantage (leave empty to force deterministic mock data)
ALPHA_VANTAGE_API_KEY=
USE_MOCK_DATA=true
MARKET_CACHE_LIVE_TTL=300
MARKET_CACHE_MOCK_TTL=60

# Throttling
THROTTLE_LOGIN=10/min
THROTTLE_BOOTSTRAP=5/min
THROTTLE_REFRESH=30/min
